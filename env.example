# doulor-proxy 环境变量示例
# 用法: cp env.example env && chmod 600 env，然后填上自己的值
# （或者直接跑 ./d.sh install，会自动生成 env 并交互式问你账号密码）

# ---------------------------------------------------------------- 必填
# 上游账号（邮箱或用户名）与密码
DOULOR_USER=
DOULOR_PASS=

# 本地 API Key：客户端用它做 Bearer，值随便设（proxy 只做本地校验）
DOULOR_API_KEY=

# ---------------------------------------------------------------- 面板
# 面板访问密码。留空则首次启动随机生成 16 位，打印进 proxy.log
# 并 chmod 600 写入 $DOULOR_STATE_DIR/panel_pass.json
DOULOR_PANEL_PASS=

# ---------------------------------------------------------------- 监听
# 默认只监听本机；要公网访问改 0.0.0.0 并自己套反向代理 + TLS
DOULOR_LISTEN_HOST=127.0.0.1
DOULOR_LISTEN_PORT=8003

# 状态目录：session.json / accounts.json / proxies.json / 日志都放这
DOULOR_STATE_DIR=/opt/doulor-proxy

# ---------------------------------------------------------------- 上游地址
# lab 站（免费通道）
DOULOR_BASE=https://cloud.doulor.cn
# v1 通道（lab 不可用时的回退）
DOULOR_V1_BASE=https://api.doulor.cn

# ---------------------------------------------------------------- 可选调优
# 只放行此外缀的模型（多实例转发时用来区分）
DOULOR_MODEL_PREFIX=workbuddy-
# 通道失效后换模型重发的最大次数
DOULOR_FAILOVER_MAX=2
# 单次请求允许的 tool 消息上限，超出的旧工具调用会被折叠
DOULOR_MAX_TOOL_MSGS=29
# 设成任意非空值可把上游原始响应体 dump 进日志（排查用，别长期开）
DOULOR_DUMP_BODY=
